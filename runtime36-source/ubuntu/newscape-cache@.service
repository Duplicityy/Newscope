[Unit]
Description=Newscape cache (%i)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=newscape
Group=newscape
UMask=0077
ExecStart=/bin/bash /srv/newscape/current/run-newscape.sh cache %i
SuccessExitStatus=143
TimeoutStopSec=60
Restart=on-failure
RestartSec=15
MemoryHigh=512M
MemoryMax=768M
OOMPolicy=stop
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
